<globalevents>
    <!-- Eventos onThink -->
    <globalevent name="save" interval="10000" type="think" script="save.lua"/>
    <globalevent name="clean" interval="2000" type="think" script="clean.lua"/>
    <globalevent name="info" interval="6000" type="think" script="info.lua"/>
    <globalevent name="magia" interval="1000" type="think" script="magia.lua"/>
    <globalevent name="info2" interval="4000" type="think" script="info2.lua"/>
    <globalevent name="info3" interval="2000" type="think" script="info3.lua"/>
    <globalevent name="saveplayer" interval="3500" type="think" script="saveplayer.lua"/>
    <globalevent name="rain" interval="5000" type="think" script="rain.lua"/>
    <globalevent name="ZombieGlobalThink" interval="5000" type="think" script="zombie/onthink.lua"/>
    <globalevent name="invasion" interval="6000" type="think" script="invasion.lua"/>
    <globalevent name="lottery" interval="14400000" type="think" script="lottery.lua"/>
    <globalevent name="offtrain_add_minutes" interval="6000" type="think" script="offtrain_addMinutes.lua"/>
    <globalevent name="talkactions" interval="2000" type="think" script="talkactions.lua"/>
    <globalevent name="GuildFrags" interval="1800000" type="think" script="GuildFragsInfo.lua"/>
    <globalevent name="info_" interval="1200" type="think" script="info_.lua"/>
    <globalevent name="tps" interval="5000" type="think" script="tps.lua"/>

    <!-- Eventos onStartup -->
    <globalevent name="ZombieGlobalStartup" type="startup" script="zombie/onstartup.lua"/>
    <globalevent name="serverstart" type="startup" script="start.lua"/>

    <!-- Players record -->
    <globalevent name="playersrecord" type="record" script="record.lua"/>
</globalevents>
